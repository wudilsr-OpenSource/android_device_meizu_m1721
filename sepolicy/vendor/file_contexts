# Binaries
/system/bin/chargeonlymode                      u:object_r:charger_exec:s0

# Fingerprint
/(vendor|system/vendor)/bin/goodixfingerprintd  u:object_r:goodixfingerprintd_exec:s0
/dev/goodix_fp                                  u:object_r:goodixfingerprintd_device:s0

# Camera
/data/vendor/qcam(/.*)?                         u:object_r:vendor_camera_data_file:s0

# Glove Mode (FTS touchscreen sysfs)
/sys/devices/platform/soc/78b7000\.i2c/i2c-3/3-0038/fts_glove_mode u:object_r:proc_touchpanel:s0
/sys/devices/platform/soc/78b7000\.i2c/i2c-3/3-0038/fts_cover_mode u:object_r:proc_touchpanel:s0

# Graphics Libs
/vendor/lib(64)?/libadreno_app_profiles\.so    u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libgpudataproducer\.so        u:object_r:same_process_hal_file:s0

# HALs
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.3-service\.meizu_m1721    u:object_r:hal_fingerprint_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.meizu_m1721                           u:object_r:hal_light_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.thermal@2\.0-service\.qti\.meizu_m1721               u:object_r:hal_thermal_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.livedisplay@2\.0-service\.meizu_m1721                  u:object_r:hal_lineage_livedisplay_qti_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.lineage\.touch@1\.0-service\.meizu_m1721                        u:object_r:hal_lineage_touch_default_exec:s0

# I/O
# This node is already labelled by QCOM but Lineage overrides it with sysfs_io_sched_tunable label
# Since qti_init_shell needs to write to it, LOS's private label isn't accessible by our vendor
# Relabel it to QCOM's sysfs_mmc_host label to get rid of denials
/sys/devices(/platform)?/soc/[a-f0-9]+.sdhci/mmc_host/mmc[0-9]/mmc[0-9]:[a-f0-9]+/block/mmcblk[0-9]/queue/read_ahead_kb u:object_r:sysfs_mmc_host:s0

# Keys disabler
/proc/mback_disable		                        u:object_r:proc_touchpanel:s0

# Legacy root dirs
/firmware(/.*)?                                 u:object_r:firmware_file:s0
/persist(/.*)?                                  u:object_r:mnt_vendor_file:s0

# MMC
/sys/devices/platform/soc/7824900.sdhci/mmc_host/mmc0/mmc0:0001/block/mmcblk0/queue/discard_max_bytes u:object_r:sysfs_mmc_host:s0

# Remosaic
/(vendor|system/vendor)/bin/remosaic_daemon     u:object_r:remosaic_daemon_exec:s0

# Rild
/(vendor|system/vendor)/radio/qcril_database/qcril.db			   u:object_r:rild_file:s0

# Sys files
/sys/devices(/platform)?/soc/7af6000\.i2c/i2c-6/6-[0-9a-f]+/leds(/.*)?          u:object_r:sysfs_leds:s0
/sys/devices(/platform)?/soc/78b7000\.i2c/i2c-3/3-[0-9a-f]+/enable_dt2w         u:object_r:proc_touchpanel:s0
/sys/devices(/platform)?/soc/78b7000\.i2c/i2c-3/3-[0-9a-f]+/disable_keys        u:object_r:proc_touchpanel:s0
